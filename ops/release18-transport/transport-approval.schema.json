{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent Stage read-only DB18 transport capture approval; no preflight/deploy authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authority",
    "command",
    "runId",
    "opsRevision",
    "serviceId",
    "target",
    "sourceBindingSha256",
    "runnerSourceSha256",
    "validFrom",
    "expiresAt",
    "gates",
