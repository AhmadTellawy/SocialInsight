# Authentication secrets: generate separate high-entropy values for each one.
AUTH_SESSION_HASH_SECRET=
OTP_HASH_SECRET=
OTP_CODE_PEPPER=

# Session policy (seconds).
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_SESSION_IDLE_TTL_SECONDS=604800
SOCKET_SESSION_REVALIDATE_SECONDS=60
SOCKET_MAX_HTTP_BUFFER_BYTES=65536
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
SOCKET_HANDSHAKE_NETWORK_PER_MINUTE=120
SOCKET_HANDSHAKE_USER_PER_MINUTE=60
SOCKET_HANDSHAKE_SESSION_PER_MINUTE=30
SOCKET_OPEN_NETWORK_LIMIT=50
SOCKET_OPEN_USER_LIMIT=5
SOCKET_OPEN_SESSION_LIMIT=2

# Set this to the exact number of trusted proxy hops in the hosting path.
TRUST_PROXY_HOPS=1

# OTP delivery policy.
OTP_TTL_SECONDS=600
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_BCRYPT_ROUNDS=10
OTP_DESTINATION_HOURLY_LIMIT=5
OTP_DESTINATION_DAILY_LIMIT=12
OTP_GLOBAL_DAILY_LIMIT=10000
