# Core runtime
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
AUTH_ALLOWED_ORIGINS=http://localhost:5173

# Database (server-side only)
DATABASE_URL=
DIRECT_URL=

# Opaque sessions and CSRF
AUTH_SESSION_HASH_SECRET=
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_RECENT_TTL_SECONDS=600
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_DEVICE_COOKIE_NAME=si_auth_device
REGISTRATION_BROWSER_COOKIE_NAME=si_registration_browser
# Temporary two-phase rollout only; remove after every supported client uses cookies.
AUTH_LEGACY_BEARER_COMPAT=false
AUTH_LEGACY_BEARER_TTL_SECONDS=3600

# Purpose-bound OTP
OTP_HASH_SECRET=
OTP_TTL_SECONDS=600
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_BCRYPT_ROUNDS=10
AUTH_TERMINAL_RETENTION_HOURS=24
AUTH_PENDING_REGISTRATION_RETENTION_HOURS=24

# Resend
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@socialinsightapp.com
EMAIL_FROM_NAME=SocialInsight
EMAIL_DELIVERY_TIMEOUT_MS=10000

# OAuth client callback destination
OAUTH_CLIENT_REDIRECT_URL=http://localhost:5173
OAUTH_PROVIDER_TIMEOUT_MS=10000
OAUTH_STATE_TTL_SECONDS=600

# Google OAuth/OIDC
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/oauth/google/callback

# Facebook Login
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/oauth/facebook/callback
