// A permanent Staging-only provider-attempt budget, never OTP/PII storage.
model StagingOtpEmailReservation {
  slot       Int      @id @default(1)
  reservedAt DateTime @default(now()) @map("reserved_at")

  @@map("staging_otp_email_reservation")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String              @id @default(uuid())
  name                String
  handle              String              @unique
  email               String?             @unique
  phone               String?             @unique
  password            String? // Temporary for migration
  passwordHash        String?             @map("password_hash") // Nullable for migration
  passwordUpdatedAt   DateTime?           @map("password_updated_at")
  avatar              String?
  avatarMediaId       String?             @unique @map("avatar_media_id")
  coverMediaId        String?             @unique @map("cover_media_id")
  bio                 String?
  location            String?
  website             String?
  birthday            DateTime?           @db.Date
  language            String?             @default("en")
  country             String?
  isPrivate           Boolean             @default(false) @map("is_private")
  mediaPrivacyTarget  Boolean?            @map("media_privacy_target")
  groupPrivacy        String              @default("Public") @map("group_privacy")
  peopleTagPermission PeopleTagPermission @default(EVERYONE) @map("people_tag_permission")

  // Verification & Status
  emailVerifiedAt DateTime? @map("email_verified_at")
  verifiedBadge   Boolean   @default(false) @map("verified_badge")
  status          String    @default("ACTIVE") // ENUM: ACTIVE, SUSPENDED, DELETED
  authProvider    String?   @map("auth_provider")

  // Cached counters
  followersCount Int @default(0) @map("followers_count")
  followingCount Int @default(0) @map("following_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  demographics           UserDemographics?
  following              Follow[]              @relation("UserFollowed")
  followedBy             Follow[]              @relation("UserFollows")
  notificationsReceived  Notification[]        @relation("NotificationRecipient")
  notificationsTriggered Notification[]        @relation("NotificationActor")
  notificationSettings   NotificationSettings?
  savedPosts             SavedPost[]
  hiddenPosts            HiddenPost[]
  reports                Report[]              @relation("Reporter")

  // Existing relations to other models
  posts                   Post[]
  comments                Comment[]
  responses               Response[]
  groups                  GroupMember[]
  likes                   UserLike[]
  commentLikes            CommentLike[]
  pushSubscriptions       PushSubscription[]
  blocking                UserBlock[]              @relation("UserBlocks")
  blockedBy               UserBlock[]              @relation("UserBlocked")
  avatarMedia             MediaAsset?              @relation("UserAvatarMedia", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  coverMedia              MediaAsset?              @relation("UserCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  ownedMedia              MediaAsset[]             @relation("MediaOwner")
  mediaPrivacyTransitions MediaPrivacyTransition[]
  mentionsReceived        Mention[]                @relation("MentionTarget")
  mentionsCreated         Mention[]                @relation("MentionActor")
  profileMentions         Mention[]                @relation("MentionProfile")
  peopleTagsReceived      PostTaggedUser[]         @relation("PeopleTagTarget")
  peopleTagsCreated       PostTaggedUser[]         @relation("PeopleTagActor")
  profileLinks            ProfileLink[]

  @@index([status, followersCount(sort: Desc), id], map: "users_status_followers_id_idx")
  @@map("users")
}

model ProfileLink {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  title         String   @db.VarChar(50)
  url           String   @db.VarChar(2048)
  normalizedUrl String   @map("normalized_url") @db.VarChar(2048)
  sortOrder     Int      @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedUrl])
  @@unique([userId, sortOrder])
  @@map("profile_links")
}

model UserDemographics {
  userId           String   @id @map("user_id")
  user             User     @relation(fields: [userId], references: [id])
  gender           String?
  maritalStatus    String?  @map("marital_status")
  ageGroup         String?  @map("age_group")
  educationLevel   String?  @map("education_level")
  employmentType   String?  @map("employment_type")
  industry         String?
  employmentSector String?  @map("employment_sector")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("user_demographics")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("push_subscriptions")
}

model Follow {
  id          String    @id @default(uuid())
  followerId  String    @map("follower_id")
  followingId String    @map("following_id")
  status      String    @default("ACTIVE") // ACTIVE, PENDING, REJECTED, CANCELLED, REMOVED, UNFOLLOWED
  requestedAt DateTime? @map("requested_at")
  approvedAt  DateTime? @map("approved_at")
  rejectedAt  DateTime? @map("rejected_at")
  cancelledAt DateTime? @map("cancelled_at")
  removedAt   DateTime? @map("removed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  following User @relation("UserFollowed", fields: [followingId], references: [id])
  follower  User @relation("UserFollows", fields: [followerId], references: [id])

  @@unique([followerId, followingId])
  @@index([followingId, status, followerId], map: "follows_following_status_follower_idx")
  @@index([followingId, status, createdAt(sort: Desc), id(sort: Desc)], map: "follows_following_status_created_id_idx")
  @@index([followerId, status, createdAt(sort: Desc), id(sort: Desc)], map: "follows_follower_status_created_id_idx")
  @@map("follows")
}

model Group {
  id                 String        @id @default(uuid())
  name               String
  description        String
  category           String
  image              String?
  imageMediaId       String?       @unique
  isPublic           Boolean       @default(true)
  joinPolicy         String        @default("OPEN")
  postingPermissions String        @default("AllMembers")
  memberCount        Int           @default(0)
  rules              String?
  isDeleted          Boolean       @default(false)
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  members            GroupMember[]
  posts              Post[]        @relation("PrimaryGroup")
  targetedPosts      Post[]        @relation("PostTargetGroups")
  imageMedia         MediaAsset?   @relation("GroupImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  mentions           Mention[]

  @@index([isDeleted])
  @@index([isDeleted, isPublic, memberCount(sort: Desc), id], map: "Group_visibility_member_count_idx")
}

model GroupMember {
  id      String @id @default(uuid())
  userId  String
  groupId String
  role    String @default("Member")
  status  String @default("JOINED") // JOINED, PENDING, INVITED
  group   Group  @relation(fields: [groupId], references: [id])
  user    User   @relation(fields: [userId], references: [id])

  @@unique([userId, groupId])
  @@index([groupId, status], map: "GroupMember_group_status_idx")
  @@index([userId, status, groupId], map: "GroupMember_user_status_group_idx")
}

model Post {
  id                 String      @id @default(uuid())
  title              String
  description        String
  type               String
  authorId           String
  groupId            String?
  isTrending         Boolean     @default(false)
  expiresAt          DateTime
  image              String?
  mediaAspectRatio   Float?
  likesCount         Int         @default(0)
  commentsCount      Int         @default(0)
  responseCount      Int         @default(0)
  category           String?
  targetAudience     String?
  pollChoiceType     String?
  imageLayout        String?
  optionPresentation String?
  showOptionNames    Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  comments           Comment[]
  group              Group?      @relation("PrimaryGroup", fields: [groupId], references: [id])
  targetedGroups     Group[]     @relation("PostTargetGroups")
  targetGroups       String?
  questions          Question[]
  responses          Response[]
  sections           Section[]
  author             User        @relation(fields: [authorId], references: [id])
  likes              UserLike[]
  media              PostMedia[]

  // Sharing/Reposting fields
  sharedFromId           String?
  sharedCaption          String?
  sharedFrom             Post?        @relation("SharedPosts", fields: [sharedFromId], references: [id])
  shares                 Post[]       @relation("SharedPosts")
  status                 String       @default("PUBLISHED") // "DRAFT", "PUBLISHED"
  currentStep            Int          @default(1)
  savedBy                SavedPost[]
  hiddenBy               HiddenPost[]
  demographics           String? // JSON string of demographic filters
  allowAnonymous         Boolean      @default(false)
  forceAnonymous         Boolean      @default(false)
  allowComments          Boolean      @default(true)
  allowMultipleSelection Boolean      @default(false)
  allowUserOptions       Boolean      @default(false)
  randomPairing          Boolean      @default(true)
  resultsWho             String?
  resultsDetail          String?
  resultsTiming          String?

  deletedAt   DateTime?
  isDeleted   Boolean   @default(false)
  sharesCount Int       @default(0)
  visibility  String    @default("PUBLIC")

  // Audit Fields
  approvedById    String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?

  // View Counts
  viewCount       Int              @default(0)
  uniqueViewCount Int              @default(0)
  views           PostView[]
  mentions        Mention[]
  hashtags        PostHashtag[]
  taggedUsers     PostTaggedUser[]

  @@index([authorId])
  @@index([sharedFromId])
  @@index([groupId])
  @@index([createdAt])
  @@index([isDeleted])
  @@index([status])
  @@index([approvedAt])
  @@index([status, isDeleted, createdAt(sort: Desc), id(sort: Desc)], map: "Post_feed_status_deleted_created_id_idx")
  @@index([authorId, status, isDeleted, createdAt(sort: Desc)], map: "Post_author_feed_created_idx")
  @@index([authorId, status, isDeleted, updatedAt(sort: Desc), id(sort: Desc)], map: "Post_author_status_updated_id_idx")
  @@index([sharedFromId, authorId], map: "Post_shared_viewer_idx")
}

model Section {
  id        String     @id @default(uuid())
  title     String
  postId    String
  order     Int        @default(0)
  questions Question[]
  post      Post       @relation(fields: [postId], references: [id])

  @@index([postId, order], map: "Section_post_order_idx")
}

model Question {
  id                 String      @id @default(uuid())
  text               String
  type               String
  image              String?
  imageMediaId       String?     @unique
  postId             String?
  sectionId          String?
  order              Int         @default(0)
  isRequired         Boolean     @default(true)
  optionPresentation String?
  showOptionNames    Boolean     @default(true)
  options            Option[]
  answers            Answer[]
  section            Section?    @relation(fields: [sectionId], references: [id])
  post               Post?       @relation(fields: [postId], references: [id])
  imageMedia         MediaAsset? @relation("QuestionImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)

  @@index([postId, order], map: "Question_post_order_idx")
  @@index([sectionId, order], map: "Question_section_order_idx")
}

model Option {
  id             String      @id @default(uuid())
  text           String
  image          String?
  imageMediaId   String?     @unique
  votes          Int         @default(0)
  questionId     String
  isCorrect      Boolean?
  isRating       Boolean     @default(false)
  ratingValue    Int         @default(0)
  order          Int         @default(0)
  withFollowUp   Boolean     @default(false)
  followUpLabel  String?
  isUserAdded    Boolean     @default(false)
  addedByUserId  String?
  addedByGuestId String?
  question       Question    @relation(fields: [questionId], references: [id])
  answers        Answer[]
  imageMedia     MediaAsset? @relation("OptionImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)

  @@index([questionId, order], map: "Option_question_order_idx")
}

enum MediaPurpose {
  POST
  PROFILE_AVATAR
  PROFILE_COVER
  GROUP_IMAGE
  QUESTION_IMAGE
  OPTION_IMAGE
}

enum MediaStatus {
  TEMPORARY
  PROCESSING
  READY
  ATTACHED
  PENDING_DELETE
  DELETED
  FAILED
}

enum MediaAccessScope {
  OWNER_ONLY
  PUBLIC
  RESTRICTED
  INHERITED_GROUP
}

enum MediaVariantKind {
  MASTER
  THUMBNAIL
  SMALL
  MEDIUM
  LARGE
  XLARGE
}

enum MediaTransitionStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}

model MediaAsset {
  id                 String           @id @default(uuid())
  ownerId            String
  purpose            MediaPurpose
  status             MediaStatus      @default(TEMPORARY)
  accessScope        MediaAccessScope @default(OWNER_ONLY)
  sourceMime         String?
  sourceWidth        Int?
  sourceHeight       Int?
  sourceByteSize     Int?
  checksum           String?
  aspectRatio        Float?
  cropX              Float?
  cropY              Float?
  cropWidth          Float?
  cropHeight         Float?
  focalX             Float?
  focalY             Float?
  altText            String?
  uploadBucket       String?
  uploadKey          String?
  errorCode          String?
  moderationStatus   String           @default("NOT_REVIEWED")
  moderationMetadata Json?
  expiresAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  owner          User           @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  variants       MediaVariant[]
  postAttachment PostMedia?
  avatarFor      User?          @relation("UserAvatarMedia")
  coverFor       User?          @relation("UserCoverMedia")
  groupFor       Group?         @relation("GroupImageMedia")
  questionFor    Question?      @relation("QuestionImageMedia")
  optionFor      Option?        @relation("OptionImageMedia")

  @@index([ownerId, status])
  @@index([status, expiresAt])
  @@index([purpose, createdAt])
}

model MediaVariant {
  id            String           @id @default(uuid())
  mediaAssetId  String
  kind          MediaVariantKind
  storageBucket String
  storageKey    String
  width         Int
  height        Int
  mime          String
  byteSize      Int
  isPublic      Boolean          @default(false)
  createdAt     DateTime         @default(now())

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([storageBucket, storageKey])
  @@unique([mediaAssetId, kind, width, isPublic])
  @@index([mediaAssetId, isPublic, width])
}

model PostMedia {
  id           String   @id @default(uuid())
  postId       String
  mediaAssetId String   @unique
  sortOrder    Int
  createdAt    DateTime @default(now())

  post       Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([postId, sortOrder])
  @@index([postId])
}

model MediaPrivacyTransition {
  id              String                @id @default(uuid())
  userId          String
  targetIsPrivate Boolean
  status          MediaTransitionStatus @default(PENDING)
  cursorAssetId   String?
  processedCount  Int                   @default(0)
  failureReason   String?
  createdAt       DateTime              @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  updatedAt       DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, status])
}

model Response {
  id          String   @id @default(uuid())
  userId      String?
  guestId     String?
  ipAddress   String?
  postId      String
  isAnonymous Boolean  @default(false)
  timestamp   DateTime @default(now())
  answers     Answer[]
  post        Post     @relation(fields: [postId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@index([guestId])
  @@index([postId])
  @@index([postId, userId], map: "Response_post_user_idx")
  @@index([postId, guestId], map: "Response_post_guest_idx")
  @@index([userId, timestamp(sort: Desc)], map: "Response_user_timestamp_idx")
  @@index([postId, timestamp(sort: Desc), id(sort: Desc)], map: "Response_post_timestamp_id_idx")
}

model Answer {
  id         String   @id @default(uuid())
  responseId String
  questionId String
  optionId   String?
  textValue  String?
  response   Response @relation(fields: [responseId], references: [id])
  question   Question @relation(fields: [questionId], references: [id])
  option     Option?  @relation(fields: [optionId], references: [id])

  @@index([responseId, questionId])
}

model Comment {
  id        String           @id @default(uuid())
  text      String
  userId    String
  postId    String
  parentId  String?
  likes     Int              @default(0)
  createdAt DateTime         @default(now())
  isDeleted Boolean          @default(false)
  parent    Comment?         @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[]        @relation("CommentReplies")
  post      Post             @relation(fields: [postId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  likesList CommentLike[]
  mentions  Mention[]
  hashtags  CommentHashtag[]

  @@index([postId])
  @@index([parentId])
  @@index([userId])
  @@index([userId, createdAt(sort: Desc)], map: "Comment_user_created_idx")
  @@index([postId, parentId, createdAt(sort: Desc), id(sort: Desc)], map: "Comment_post_parent_created_id_idx")
}

model NotificationSettings {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  settings  String // JSON string storing: myPosts, sharedPosts, toggles
  updatedAt DateTime @updatedAt
}

model Notification {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?           @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type       String
  message    String          @default("")
  targetType String?
  targetId   String?
  payload    String? // JSON string
  dedupeKey  String?         @unique @map("dedupe_key")
  isRead     Boolean         @default(false)
  readAt     DateTime?
  createdAt  DateTime        @default(now())
  mention    Mention?        @relation("MentionNotification")
  peopleTag  PostTaggedUser? @relation("PeopleTagNotification")

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_user_created_id_idx")
  @@map("notifications")
}

enum MentionSourceType {
  POST
  COMMENT
  REPLY
  PROFILE
  GROUP
}

enum MentionSurface {
  POST_TITLE
  POST_DESCRIPTION
  REPOST_CAPTION
  COMMENT_TEXT
  PROFILE_BIO
  GROUP_DESCRIPTION
  GROUP_RULES
}

enum MentionState {
  STAGED
  ACTIVE
}

enum PeopleTagPermission {
  EVERYONE
  FOLLOWING
  NO_ONE
}

enum PeopleTagStatus {
  PENDING
  ACCEPTED
  REJECTED
  REMOVED
}

model Mention {
  id             String            @id @default(uuid())
  targetUserId   String
  actorUserId    String
  postId         String?
  commentId      String?
  profileUserId  String?
  groupId        String?
  sourceType     MentionSourceType
  state          MentionState      @default(ACTIVE)
  notificationId String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  targetUser   User                @relation("MentionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  actorUser    User                @relation("MentionActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  post         Post?               @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      Comment?            @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profileUser  User?               @relation("MentionProfile", fields: [profileUserId], references: [id], onDelete: Cascade)
  group        Group?              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  notification Notification?       @relation("MentionNotification", fields: [notificationId], references: [id], onDelete: SetNull)
  occurrences  MentionOccurrence[]

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([postId, state])
  @@index([commentId, state])
  @@index([profileUserId])
  @@index([groupId])
}

model MentionOccurrence {
  id          String         @id @default(uuid())
  mentionId   String
  surface     MentionSurface
  startOffset Int
  endOffset   Int
  rawText     String

  mention Mention @relation(fields: [mentionId], references: [id], onDelete: Cascade)

  @@unique([mentionId, surface, startOffset, endOffset])
  @@index([mentionId, surface])
}

model Hashtag {
  id             String   @id @default(uuid())
  normalizedName String   @unique
  displayName    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  posts    PostHashtag[]
  comments CommentHashtag[]

  @@index([createdAt])
}

model PostHashtag {
  postId    String
  hashtagId String
  createdAt DateTime @default(now())

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  @@index([hashtagId, postId])
  @@index([createdAt])
}

model CommentHashtag {
  commentId String
  hashtagId String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([commentId, hashtagId])
  @@index([hashtagId, commentId])
}

model PostTaggedUser {
  id             String          @id @default(uuid())
  postId         String
  taggedUserId   String
  taggedByUserId String
  status         PeopleTagStatus @default(PENDING)
  notificationId String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  acceptedAt     DateTime?
  rejectedAt     DateTime?
  removedAt      DateTime?

  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  taggedUser   User          @relation("PeopleTagTarget", fields: [taggedUserId], references: [id], onDelete: Cascade)
  taggedByUser User          @relation("PeopleTagActor", fields: [taggedByUserId], references: [id], onDelete: Cascade)
  notification Notification? @relation("PeopleTagNotification", fields: [notificationId], references: [id], onDelete: SetNull)

  @@unique([postId, taggedUserId])
  @@index([taggedUserId, status, createdAt])
  @@index([taggedByUserId, createdAt])
  @@index([postId, status])
}

model UserLike {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@index([userId, createdAt(sort: Desc)], map: "UserLike_user_created_idx")
  @@index([postId, createdAt(sort: Desc), id(sort: Desc)], map: "UserLike_post_created_id_idx")
}

model OTPCode {
  id         String   @id @default(uuid())
  identifier String
  code       String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier])
}

model OtpChallenge {
  id              String   @id @default(uuid())
  destinationHash String   @map("destination_hash") @db.Char(64)
  purpose         String   @db.VarChar(64)
  subject         String   @db.VarChar(255)
  codeHash        String   @map("code_hash") @db.VarChar(255)
  deliveryStatus  String   @default("PENDING") @map("delivery_status") @db.VarChar(16)
  attempts        Int      @default(0)
  maxAttempts     Int      @default(5) @map("max_attempts")
  expiresAt       DateTime @map("expires_at")
  cooldownUntil   DateTime @map("cooldown_until")
  version         Int      @default(1)
  consumedAt      DateTime? @map("consumed_at")
  invalidatedAt   DateTime? @map("invalidated_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([destinationHash, purpose, subject, version], map: "otp_challenges_destination_purpose_subject_version_key")
  @@index([destinationHash, purpose, version(sort: Desc)], map: "otp_challenges_destination_purpose_version_idx")
  @@index([subject, purpose, version(sort: Desc)], map: "otp_challenges_subject_purpose_version_idx")
  @@index([expiresAt], map: "otp_challenges_expires_idx")
  @@map("otp_challenges")
}

model PendingRegistration {
  id           String    @id @default(uuid())
  email        String    @unique
  fullName     String
  dob          DateTime  @db.Date
  password     String?
  handle       String?   @unique
  currentStep  Int       @default(2)
  otpCode      String?
  otpExpiresAt DateTime?
  registrationSecretHash String? @map("registration_secret_hash") @db.Char(64)
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())
}

model SavedPost {
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), postId(sort: Desc)], map: "user_saved_posts_user_created_post_idx")
  @@map("user_saved_posts")
}

model HiddenPost {
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
  @@map("user_hidden_posts")
}

model Report {
  id             String    @id @default(uuid())
  reporterId     String    @map("reporter_id")
  targetType     String    @map("target_type") // POST, COMMENT, USER
  targetId       String    @map("target_id")
  dedupeKey      String?   @unique @map("dedupe_key")
  reason         String
  description    String?
  status         String    @default("PENDING")
  targetSnapshot Json?     @map("target_snapshot")
  resolutionNote String?   @map("resolution_note")
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  reporter User @relation("Reporter", fields: [reporterId], references: [id])

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model InteractionEvent {
  id               String   @id @default(uuid())
  actor_user_id    String
  event_type       String
  post_id          String?
  target_user_id   String?
  comment_id       String?
  method           String? // COPY_LINK | NATIVE_SHARE | REPOST
  new_state        Boolean? // Only for SAVE_TOGGLE and FOLLOW_TOGGLE
  dwell_time_ms    Int? // Only for POST_VIEW_END
  source_surface   String // FEED | PROFILE | SAVED | SEARCH | DEEP_LINK
  position_in_feed Int? // Integer if FEED, else NULL
  session_id       String
  device_type      String // WEB | ANDROID | IOS
  created_at       DateTime @default(now())

  @@index([actor_user_id, created_at(sort: Desc)])
  @@index([post_id, created_at(sort: Desc)])
  @@index([target_user_id, created_at(sort: Desc)])
  @@index([event_type, created_at(sort: Desc)])
  @@index([session_id])
}

model CommentLike {
  id        String   @id @default(uuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId, createdAt(sort: Desc), id(sort: Desc)], map: "CommentLike_comment_created_id_idx")
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("UserBlocks", fields: [blockerId], references: [id])
  blocked   User     @relation("UserBlocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@map("user_blocks")
}

model PostView {
  id            String   @id @default(uuid())
  postId        String
  viewerKey     String // e.g., "user:<userId>" or "session:<guestSessionId>"
  source        String? // e.g., "FEED", "PROFILE"
  deviceType    String? // e.g., "WEB", "IOS"
  ipHash        String?
  userAgentHash String?
  viewedAt      DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, viewerKey, viewedAt])
  @@index([postId, viewedAt])
  @@index([viewerKey])
  @@map("post_views")
}
