      "status":{"const":"PASSED"},"evidenceSha256":{"$ref":"#/$defs/hash"},"sourceBindingSha256":{"$ref":"#/$defs/hash"},"contractSha256":{"$ref":"#/$defs/hash"},"project":{"type":"string"},"host":{"type":"string"},"transport":{"enum":["direct","session"]},"nodePlatform":{"const":"linux"},"prismaVersion":{"const":"6.19.2"},"cliSha256":{"const":"69a2bd6412521259b90c653aff9822b6d2fc63a17f9c46d46d07d319ea0dbb3e"},"engineSha256":{"const":"5d42b181631fd20bb0ecc5abcdba72575e7f467a0d52f4d5ef1ff28f0c74e6e9"},"caSha256":{"const":"700723581420dd1ac98fd7e9ac529f0ef210eadcaf87fc868a3ad7d114c2f3b7"},"validPeer":{"const":true},"wrongCaRejectedBeforeCredentials":{"const":true},"wrongHostnameRejectedBeforeCredentials":{"const":true},"noTlsRejectedBeforeCredentials":{"const":true},"noPlaintextFallback":{"const":true},"databaseTls":{"const":true},"timezone":{"const":"UTC"},"lockTimeoutMs":{"const":5000},"statementTimeoutMs":{"const":120000},"observedAt":{"$ref":"#/$defs/utc"}
