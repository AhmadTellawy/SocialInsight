{
  "git": {
    "deploymentEnabled": {
      "codex/security-remediation-release": false
    }
  },
  "buildCommand": "vite build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://socialinsight-media-e2e-api-20261001.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://socialinsight-media-e2e-api-20261001.onrender.com/socket.io/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://socialinsight-media-e2e-api-20261001.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
