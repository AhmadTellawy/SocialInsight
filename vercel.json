{
  "git": {
    "deploymentEnabled": {
      "codex/account-settings-stage-bootstrap": false,
      "codex/heif-linux-validation": false
    }
  },
  "buildCommand": "vite build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://socialinsight-api.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://socialinsight-api.onrender.com/socket.io/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://socialinsight-api.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
